# Copy to .env. These values stay on the server and are never sent to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# HOST=0.0.0.0
# PORT=8000
# Set to * only when the app runs behind a trusted reverse proxy (Render, nginx).
# FORWARDED_ALLOW_IPS=127.0.0.1

# When another host serves the website and proxies /api/* here (e.g. Netlify), list its address:
# ALLOWED_ORIGINS=https://your-site.netlify.app
